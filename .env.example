# ============================================================================
#  Discord-Bot fuer VerifyLink
# ============================================================================
#  Der Bot braucht KEINEN Datenbankzugriff. Alles laeuft ueber die
#  REST-Schnittstelle des Plugins, und nur das Plugin schreibt.
# ============================================================================

# --- Discord ---
DISCORD_TOKEN=

# Auf welchem Server die Befehle registriert werden. Leer = global, dann
# dauert die Verteilung bis zu einer Stunde.
GUILD_ID=

# Rolle, die nach erfolgreicher Verknuepfung vergeben wird. Leer = keine.
# Die Rolle des Bots muss in der Rangfolge UEBER dieser Rolle stehen.
VERIFIED_ROLE_ID=

# Optionaler Protokollkanal.
LOG_CHANNEL_ID=

# Discord-IDs, die als Verwaltung gelten (durch Komma getrennt).
ADMIN_USER_IDS=

# Der MEMBERS-Intent ist im Entwicklerportal zustimmungspflichtig. Ist er
# dort nicht freigegeben, verweigert Discord die Anmeldung komplett.
# Die Rollenvergabe funktioniert auch ohne ihn.
MEMBERS_INTENT=false

LOG_LEVEL=INFO

# --- Zugang zum VerifyLink-Plugin ---
# Im selben Docker-Netz: http://velocity:8787
# Sonst die Adresse des Proxys.
VERIFYLINK_API_URL=http://velocity:8787

# Muss mit api.token in plugins/verifylink/config.yml uebereinstimmen.
#
# ACHTUNG: Wer diesen Token besitzt, kann jede beliebige Discord-ID an jeden
# gueltigen Code binden. Er ist damit praktisch so wertvoll wie ein
# Discord-Admin-Zugang - nie in ein Repository, nie in einen Chat.
VERIFYLINK_API_TOKEN=
